{
  "name": "ultimate-devtools-extractor",
  "version": "2.5.0",
  "description": "Ultimate DevTools Extractor - TypeScript + Playwright + CDP, with a web dashboard, an MCP server and an LLM agent",
  "main": "dist/server/server.js",
  "scripts": {
    "start": "npm run build:web && tsx src/server/server.ts",
    "dashboard": "npm run build:web && tsx src/server/server.ts",
    "dev:web": "tsc -p web --watch",
    "extract": "tsx src/main.ts",
    "collectors": "tsx src/bin/collector-cli.ts",
    "mcp": "tsx src/mcp/main.ts",
    "agent": "tsx src/ai/cli.ts",
    "build": "tsc && npm run build:web",
    "build:web": "tsc -p web",
    "start:prod": "node dist/server/server.js",
    "start:mcp": "node dist/mcp/main.js",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "setup": "playwright install chromium",
    "clean": "rm -rf dist output public/js"
  },
  "author": "saeed dehghan",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "openai": "^7.42.0",
    "playwright": "^1.64.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "devtools-extractor-mcp": "dist/mcp/main.js",
    "devtools-extractor-agent": "dist/ai/cli.js"
  }
}
